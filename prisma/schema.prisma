// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

enum UsuarioStatus {
  INATIVO
  ATIVO
}

model Livro {
  id          Int          @id @default(autoincrement())
  titulo      String
  autor       String
  quant       Int          // Estoque de livros disponíveis na estante
  preco_multa Float        // Valor cobrado por dia de atraso na devolução
  deleted     Boolean      @default(false)
  deletedAt   DateTime?
  emprestimos Emprestimo[]

  @@map("livros")
}

model Aluno {
  id           Int          @id @default(autoincrement())
  nome         String
  email        String       @unique
  saldo_credit Float        @default(0.0) // Saldo para pagar multas ou créditos pré-pagos
  emprestimos  Emprestimo[]
  depositos    Deposito[]

  @@map("alunos")
}

model Emprestimo {
  id        Int      @id @default(autoincrement())
  alunoId   Int
  livroId   Int
  quant     Int      @default(1)
  data      DateTime @default(now())

  aluno     Aluno    @relation(fields: [alunoId], references: [id], onDelete: Cascade)
  livro     Livro    @relation(fields: [livroId], references: [id], onDelete: Cascade)

  @@map("emprestimos")
}

model Deposito {
  id        Int      @id @default(autoincrement())
  alunoId   Int
  tipo      String   // Ex: "PIX", "Dinheiro"
  valor     Float
  data      DateTime @default(now())

  aluno     Aluno    @relation(fields: [alunoId], references: [id], onDelete: Cascade)

  @@map("depositos")
}

model Usuario {
  id                     Int            @id @default(autoincrement())
  nome                   String
  email                  String         @unique
  senha                  String
  status                 UsuarioStatus  @default(INATIVO)
  nivelAcesso            Int            @default(1)
  codigoAtivacao         Int            @unique
  ultimoLogin            DateTime?
  codigoRecuperacao      String?
  codigoRecuperacaoExpira DateTime?
  createdAt              DateTime       @default(now())
  updatedAt              DateTime       @updatedAt
  logs                   Log[]

  @@map("usuarios")
}

model Log {
  id        Int      @id @default(autoincrement())
  usuarioId Int
  acao      String
  detalhe   String?
  sucesso   Boolean  @default(true)
  createdAt DateTime @default(now())

  usuario   Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@map("logs")
}